  "timeline": [
    {
      "kind": "event",
      "event_id": 1,
      "tick": 1,
      "lane": "mysql.executor",
      "event_name": "mysql.executor.iterator.open",
      "meaning": "执行器打开索引读取 iterator，准备按优化器选择的二级索引读取一行。"
    },
    {
      "kind": "event",
      "event_id": 2,
      "tick": 2,
      "lane": "mysql.handler.api",
      "event_name": "mysql.handler.api.index_read.call",
      "meaning": "执行器通过 handler API 调用存储引擎；Server 只传 key buffer 和 record buffer，不直接操作 InnoDB 页。"
    },
    {
      "kind": "event",
      "event_id": 3,
      "tick": 3,
      "lane": "innodb.handler",
      "event_name": "innodb.handler.index_read.enter",
      "meaning": "InnoDB handler 接住 Server 的 index_read 请求，准备在 orders 表的二级索引 idx_user_id 上查找。"
    },
    {
      "kind": "event",
      "event_id": 4,
      "tick": 4,
      "lane": "innodb.row",
      "event_name": "innodb.row.search_mvcc.enter",
      "meaning": "InnoDB 进入 row_search_mvcc：既要查 B+Tree，也要用 ReadView 判断记录版本是否可见。"
    },
    {
      "kind": "event",
      "event_id": 5,
      "tick": 5,
      "lane": "innodb.btree",
      "event_name": "innodb.btree.search.root.enter",
      "meaning": "B+Tree 搜索先进入 root page，根据 search tuple 选择要下降到的 child page。"
    },
    {
      "kind": "mark_decision",
      "event_id": 5,
      "tick": 5,
      "entity_id": "page:8:3",
      "label": "choose child page 5",
      "value": {
        "chosen_child_page_no": 5
      }
    },
    {
      "kind": "event",
      "event_id": 6,
      "tick": 6,
      "lane": "innodb.btree",
      "event_name": "innodb.btree.search.leaf.enter",
      "meaning": "搜索下降到 leaf page。真正的记录匹配会在页内部继续完成。"
    },
    {
      "kind": "event",
      "event_id": 7,
      "tick": 7,
      "lane": "innodb.page",
      "event_name": "innodb.page.directory.binary_search.step",
      "meaning": "在 leaf page 内，InnoDB 先用页目录做二分，快速缩小记录所在槽范围。"
    },
    {
      "kind": "mark_decision",
      "event_id": 7,
      "tick": 7,
      "entity_id": "slot:8:5:4",
      "label": "binary search compare",
      "value": {
        "compare_result": "search_key_greater",
        "next_range": "slot 5..8"
      }
    },
    {
      "kind": "event",
      "event_id": 8,
      "tick": 8,
      "lane": "innodb.page",
      "event_name": "innodb.page.record.linear_scan.step",
      "meaning": "页目录只定位到一组记录；槽内还要沿 record chain 逐条比较。"
    },
    {
      "kind": "mark_decision",
      "event_id": 8,
      "tick": 8,
      "entity_id": "record:8:5:11",
      "label": "record compare miss",
      "value": {
        "compare_result": "search_key_less_than_record"
      }
    },
    {
      "kind": "event",
      "event_id": 9,
      "tick": 9,
      "lane": "innodb.page",
      "event_name": "innodb.page.record.match",
      "meaning": "在 leaf page 的 record chain 中找到二级索引键 user_id=10 的候选记录。"
    },
    {
      "kind": "mark_decision",
      "event_id": 9,
      "tick": 9,
      "entity_id": "record:8:5:12",
      "label": "record matched",
      "value": {
        "compare_result": "equal"
      }
    },
    {
      "kind": "event",
      "event_id": 10,
      "tick": 10,
      "lane": "innodb.mvcc",
      "event_name": "innodb.mvcc.visibility.check",
      "meaning": "ReadView 检查记录的 trx_id=90，发现它早于当前活跃事务范围，因此这个版本对本次一致性读可见。"
    },
    {
      "kind": "mark_decision",
      "event_id": 10,
      "tick": 10,
      "entity_id": "record:8:5:12",
      "label": "visible to ReadView",
      "value": {
        "visible": true,
        "reason": "record_trx_id < up_limit_id"
      }
    },
    {
      "kind": "event",
      "event_id": 11,
      "tick": 11,
      "lane": "innodb.row",
      "event_name": "innodb.row.mysql_buffer.write",
      "meaning": "InnoDB 把可见记录解码后写入 Server 提供的 record buffer，Server 随后才能向上层 executor 返回这一行。"
    },
    {
      "kind": "event",
      "event_id": 12,
      "tick": 12,
      "lane": "mysql.handler.api",
      "event_name": "mysql.handler.api.index_read.return",
      "meaning": "handler::index_read 返回成功。对 Server 来说，结果行已经在 record buffer 里。"
    },
    {
      "kind": "event",
      "event_id": 13,
      "tick": 13,
      "lane": "mysql.executor",
      "event_name": "mysql.executor.iterator.row.emit",
      "meaning": "执行器从 record buffer 取到一行，向上层结果发送逻辑交付这一行。"
    }
