        <mxCell id="2" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1;fontColor=#111827;" value="MySQL 源码组件与数字孪生建模图&#xa;从 Server 层到 InnoDB，再到 OS/文件系统：每个组件在哪里、我们建模成什么、事件命名空间怎么落" vertex="1">
          <mxGeometry height="70" width="1880" x="40" y="20" as="geometry" />
