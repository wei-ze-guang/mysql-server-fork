        <mxCell id="3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f9fafb;strokeColor=#6b7280;fontSize=14;fontColor=#374151;" value="阅读方式：左侧是 MySQL 真实源码层级；右侧是我们为了可视化额外建立的模型实体和事件命名空间。B+Tree、Page、Record、ReadView、Lock 等不一定是“模块组件”，但它们是解释 MySQL 原理必须可视化的对象。" vertex="1">
          <mxGeometry height="55" width="1840" x="80" y="105" as="geometry" />
